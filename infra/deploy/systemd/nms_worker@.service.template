[Unit]
Description=NMS Polling Worker Engine (instance %i) — Leader-Elected Poller Cluster
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User={{SYS_USER}}
Group={{SYS_GROUP}}
WorkingDirectory=/usr/local/bin
ExecStartPre=/usr/local/bin/nms_engine_ready.sh
ExecStart=/usr/local/bin/nms_engine --poller --bgp --syslog --netflow
Restart=always
RestartSec=3
EnvironmentFile=/etc/nms/nms.env
EnvironmentFile=-/etc/nms/workers/%i.env
Environment="APP_ROOT={{APP_ROOT}}"
Environment="PORT=%i"
Environment="GOGC=300"
# Sized for the 5000-device target (ARCHITECTURE.md Phase 2 model): with the
# 2-worker cluster each instance must absorb ~12.5k syslog msg/s + ~7.5k
# netflow pkt/s. The old 192MiB/384M caps OOM-killed workers long before
# that; 512MiB heap inside a 1g cgroup gives ~5x current RSS headroom.
Environment="GOMEMLIMIT=512MiB"
Environment="GOMAXPROCS=3"
WatchdogSec=30
MemoryMax=1G
MemoryHigh=768M
CPUQuota=300%
# NoNewPrivileges stays off: the engine shells out via `sudo -n` for UFW and
# fail2ban management, which requires setuid. CAP_SYS_ADMIN removed 2026-09-30
# (audit M8): nothing in the engine performs mount/namespace operations —
# docker CLI is client-side only and needs no kernel caps.
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
PrivateTmp=no
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
