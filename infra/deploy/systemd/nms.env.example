# NMS engine environment — copy to /etc/nms/nms.env (chmod 600, gitignored)
# DATABASE_URL: pgpool writes port (15432) or direct standby. Credentials come
# from the stack .env at setup time.
DATABASE_URL=postgresql://rnd_user:REDACTED@localhost:15432/rnd_db?sslmode=disable
# PROJECT_DIR / PYTHON_BIN are auto-derived by deploy/bootstrap.sh at setup
# time from the repository location — do NOT hardcode a specific machine path.
PROJECT_DIR=
PYTHON_BIN=

# Per-instance settings live in /etc/nms/instances/<PORT>.env, e.g.:
#   SYSLOG_PORT, NETFLOW_PORT, SFLOW_PORT
#   NMS_LEADER_PRIORITY=0      lower number = higher priority (8000 should be 0,
#                              8001=1, ... 8004=4). The highest-priority LIVE
#                              instance always holds worker leadership and
#                              reclaims it automatically when it returns.
#   NMS_INSTANCE_NAME=MY_NET_NOC friendly name shown in Telegram HA
#                              alerts (defaults to MY_NET_NOC)
NMS_INSTANCE_NAME=MY_NET_NOC
#
# ENGINE_INSTANCES (deploy/bootstrap only, not read by the engine):
#   ENGINE_INSTANCES="8000 8001 8002 8003 8004"   which engine instances to run
#   ALERT_SUBNET="172.16.0.0/12"                  ufw source allowed to reach
#                                                 the Telegram relay on 8098
