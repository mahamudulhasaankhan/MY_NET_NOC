# NMS engine environment — copy to /etc/nms/nms.env (chmod 600, gitignored)
# DATABASE_URL: the DB front door — pgpool-proxy on 127.0.0.1:6432 — which
# load-balances across the two pgpool containers (HA). Do NOT point this at a
# single PG node (15432/25432) or at one pooler port (5432): that recreates a
# single point of failure. Credentials come from the stack .env at setup time.
DATABASE_URL=postgresql://rnd_user:REDACTED@localhost:6432/rnd_db?sslmode=disable
# PROJECT_DIR / PYTHON_BIN are auto-derived by deploy/bootstrap.sh at setup
# time from the repository location — do NOT hardcode a specific machine path.
PROJECT_DIR=
PYTHON_BIN=

# Per-instance settings live in /etc/nms/instances/<PORT>.env, e.g.:
#   SYSLOG_PORT, NETFLOW_PORT, SFLOW_PORT
#   NMS_LEADER_PRIORITY=0      lower number = higher priority (8000 should be 0,
#                              8001=1, ... 8004=4). The highest-priority LIVE
#                              instance always holds worker leadership and
#                              reclaims it automatically when it returns.
#   NMS_INSTANCE_NAME=MY_NET_NOC friendly name shown in Telegram HA
#                              alerts (defaults to MY_NET_NOC)
NMS_INSTANCE_NAME=MY_NET_NOC
#
# ENGINE_INSTANCES (deploy/bootstrap only, not read by the engine):
#   ENGINE_INSTANCES="8000 8001 8002 8003 8004"   which engine instances to run
#   ALERT_SUBNET="172.16.0.0/12"                  ufw source allowed to reach
#                                                 the Telegram relay on 8098
#
# ── Collective 3-worker tuning (single source of truth) ──────────────────────
# Every value below is read by ALL three Tier-A workers (nms_worker@9000-9002)
# from this file — change it here once, then restart the workers to apply:
#   sudo systemctl restart nms_worker@9000 nms_worker@9001 nms_worker@9002
# Values match the compiled-in defaults; override only to deviate.
# NOTE: no inline comments on assignment lines — systemd EnvironmentFile does
# not strip them (bash does), which would corrupt the value.
#
# NMS_PING_INTERVAL_MS: probe spacing between the 3 pings (default 300)
NMS_PING_INTERVAL_MS=300
# NMS_SYSLOG_WORKERS: syslog ingest goroutines (default 8)
NMS_SYSLOG_WORKERS=8
# NMS_NETFLOW_WORKERS: netflow ingest goroutines (default 8)
NMS_NETFLOW_WORKERS=8
# NMS_SOURCE_RATE_LIMIT: datagrams/s per source host (default 500)
NMS_SOURCE_RATE_LIMIT=500
# NMS_DOWN_ALERT_THRESHOLD: failed probes before DOWN alert (default 3)
NMS_DOWN_ALERT_THRESHOLD=3
