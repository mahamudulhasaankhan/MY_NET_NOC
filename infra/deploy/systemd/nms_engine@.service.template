[Unit]
Description=NMS Ultra High Performance Go Engine (instance %i)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User={{SYS_USER}}
Group={{SYS_GROUP}}
WorkingDirectory=/usr/local/bin
ExecStartPre=/usr/local/bin/nms_engine_ready.sh
ExecStart=/usr/local/bin/nms_engine --api
Restart=always
RestartSec=3
EnvironmentFile=/etc/nms/nms.env
EnvironmentFile=-/etc/nms/instances/%i.env
Environment="APP_ROOT={{APP_ROOT}}"
Environment="PORT=%i"
Environment="GOGC=200"
Environment="GOMEMLIMIT=256MiB"
Environment="GOMAXPROCS=2"
WatchdogSec=25
MemoryMax=512M
MemoryHigh=384M
CPUQuota=300%
NoNewPrivileges=no
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
PrivateTmp=no
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
