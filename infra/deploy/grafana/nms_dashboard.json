        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(nms_http_request_duration_seconds_bucket[$__rate_interval])) by (le, method, path))",
          "legendFormat": "{{method}} {{path}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "99th percentile HTTP request latency, broken down by method and path"
