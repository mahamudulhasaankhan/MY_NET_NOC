 # Nginx Reverse Proxy for NMS Stack (with SSL + WAF)
#
# Usage:
#   sudo ln -s /path/to/RnD_Server/deploy/nginx/nms_proxy /etc/nginx/sites-enabled/
#   sudo cp /path/to/RnD_Server/deploy/nginx/waf-rules.conf /etc/nginx/waf-rules.conf
#   sudo nginx -s reload

include /etc/nginx/waf-rules.conf;
# Custom WAF rule maps (generated by the WAF Control Center, http scope).
# Must stay AFTER waf-rules.conf so the core maps are defined first.
include /etc/nginx/waf-custom-maps.conf;

# ── TLS hardening (shared by all SSL servers) ──
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
ssl_session_cache shared:SSL:20m;
ssl_session_timeout 1d;
ssl_session_tickets off;
ssl_stapling off;
ssl_dhparam /etc/nginx/ssl/dhparam.pem;

# 1. Grafana on Port 8081 (HTTPS)
server {
    listen 8081 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    if ($bad_bot)    { return 403; }
    if ($attack_uri) { return 403; }
    if ($sqli_attack) { return 403; }
    if ($spoofed_browser_bot) { return 403; }

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 2. Portainer on Port 8082 (HTTPS)
server {
    listen 8082 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    # ── WAF (URI-based only — Portainer webhooks are non-browser clients) ──
    if ($attack_uri) { return 403; }
    if ($sqli_attack) { return 403; }

    auth_basic "NMS Secure Access - Container Management";
    auth_basic_user_file /etc/nginx/.htpasswd_portainer;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/websocket/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}

