# 4. Main NMS App on Port 443 (HTTPS + HTTP/2 Multiplexing)
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_types text/css text/javascript application/javascript
               text/plain application/json image/svg+xml
               image/x-icon image/png image/jpeg image/webp
               font/woff2 font/woff application/wasm;
    gzip_min_length 256;
    gzip_comp_level 5;
    gzip_proxied any;

    # ── Security Headers ──
    # Shared with every location that defines its own add_header: nginx only
    # inherits add_header from a parent level when the child defines none.
    include /etc/nginx/nms_security_headers.conf;

    client_max_body_size 100M;
    root {{APP_ROOT}}/frontend/dist;
    index index.html;

    # SPA entry must always revalidate so new deploys are picked up instantly.
    # The security-header include is repeated here on purpose: this location
    # sets add_header, which would otherwise suppress the server-level
    # inheritance and serve the login page without CSP / HSTS / X-Frame-Options.
    location = /index.html {
        include /etc/nginx/nms_security_headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }


    # ── WAF: Block malicious requests & enforce rate limiting ──
    # The deny rules are DB-driven (WAF Control Center → /security/waf):
    # toggling a rule in the UI rewrites /etc/nginx/waf-enabled.conf and
    # safely reloads nginx (rollback on test failure).
    include /etc/nginx/waf-enabled.conf;

    limit_req_status 429;

    # WAF edge-blocks (server-level deny ifs: bad_bot UA, attack URIs,
    # SQLi patterns) get a machine-readable JSON body instead of the
    # default HTML page. Proxied engine responses (including engine 403s
    # like CSRF failures) pass through untouched because
    # proxy_intercept_errors defaults to off.
    error_page 403 = @waf_json_403;

    # Login gate: 30r/m + burst 20 (shared office NAT; brute-force enforced by engine PoW + spray-block)
    location /api/v3/login/ {
        limit_req zone=login_limit burst=20 nodelay;
        # WAF edge-blocks (bad_bot UA map) return a machine-readable body -
        # CLI testers otherwise see a bare HTML 403 with no explanation.
        # Proxied engine 403s (CSRF etc.) pass through untouched:
        # proxy_intercept_errors defaults to off.
        error_page 403 = @waf_json_403;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @waf_json_403 {
        default_type application/json;
        return 403 '{"status":"error","code":"WAF_BLOCKED","message":"Automated clients (curl/wget/python) are blocked at the edge. Use a browser, or retry with a browser User-Agent."}';
    }

    # Heavy operations (ping sweeps, bulk automation): 30r/m
    location /api/v3/tools/ {
        limit_req zone=bulk_limit burst=10 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v3/automation/ {
        limit_req zone=bulk_limit burst=10 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    # SSE / Live Events Stream — v3 (no buffering, persistent)
    location /api/v3/events/ {
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }

    # Telemetry: own quota so report-storms never eat api_global budget
    location /api/v3/telemetry/ {
        limit_req zone=telemetry_limit burst=20 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Go API V3
    location /api/v3/ {
        limit_req zone=api_global burst=50 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Unknown API prefixes are answered with 404 at the edge — never the
    # SPA fallback. All real endpoints live under /api/v3/ (matched above
    # by their more specific location blocks).
    location /api/ {
        return 404;
    }

    location /logout {
        try_files $uri $uri/ /index.html;
    }

    # React App Hashed Assets (JS/CSS - immutable cache + precompressed gzip)
    location /assets/ {
        gzip_static on;
        include /etc/nginx/nms_security_headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # React App SPA routing (Never cache index.html so JS updates apply immediately)
    location / {
        include /etc/nginx/nms_security_headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri $uri/ /index.html;
    }
}

# 5. Redirect HTTP (port 80) to HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

# 6. ntfy push notifications on Port 8080 (HTTPS, WebSocket for live push)
server {
    listen 8080 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    # ── WAF (URI-based only — ntfy publishers are non-browser clients) ──
    if ($attack_uri) { return 403; }
    if ($sqli_attack) { return 403; }

    auth_basic "NMS Secure Access";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;  # overwrite — client-supplied XFF is spoofable
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for ntfy live push
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}

