# 9. Engine metrics bridge for Docker containers (VictoriaMetrics scrape).
#    EXPOSES ONLY /metrics — previously a raw socat forwarder leaked the full
#    engine API to every container (and the LAN via docker0), bypassing the
#    WAF, fail2ban and PoW layers entirely.
#    NOTE: this block MUST stay in sync with the live nms_proxy file —
#    previously it existed only live and was lost on template regenerate.
server {
    listen 172.17.0.1:8000;
    server_name _;

    location = /metrics {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        access_log off;
    }

    location / {
        return 403;
    }
}

# 10. Per-instance metrics bridges (fix 8001-8004 blindspot).
#     Each engine instance gets its own docker0 port so VictoriaMetrics can
#     scrape all 5 Tier-B instances with an instance label:
#       18080 -> 8000, 18081 -> 8001, 18082 -> 8002, 18083 -> 8003, 18084 -> 8004
#     8090 was NOT used: it is already the ntfy internal port (see section 6 above).
#     EXPOSES ONLY /metrics — every other path returns 403.
server {
    listen 172.17.0.1:18080;
    server_name _;

    location = /metrics {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        access_log off;
    }

    location / {
        return 403;
    }
}

