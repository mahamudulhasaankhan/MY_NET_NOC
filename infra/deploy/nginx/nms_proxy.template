 # Nginx Reverse Proxy for NMS Stack (with SSL + WAF)
#
# Usage:
#   sudo ln -s /path/to/RnD_Server/deploy/nginx/nms_proxy /etc/nginx/sites-enabled/
#   sudo cp /path/to/RnD_Server/deploy/nginx/waf-rules.conf /etc/nginx/waf-rules.conf
#   sudo nginx -s reload

include /etc/nginx/waf-rules.conf;

# ── TLS hardening (shared by all SSL servers) ──
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
ssl_stapling off;
ssl_dhparam /etc/nginx/ssl/dhparam.pem;

# 1. Grafana on Port 8081 (HTTPS)
server {
    listen 8081 ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    if ($bad_bot)    { return 403; }
    if ($attack_uri) { return 403; }

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 2. Portainer on Port 8082 (HTTPS)
server {
    listen 8082 ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    auth_basic "NMS Secure Access";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/websocket/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}

# 3. Gitea on Port 8083 (HTTPS)
server {
    listen 8083 ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    # ── WAF Protection ──
    if ($bad_bot)     { return 403; }
    if ($attack_uri)  { return 403; }
    if ($sqli_attack) { return 403; }

    auth_basic "NMS Secure Access";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


# 4. Main NMS App on Port 443 (HTTPS)
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    gzip on;
    gzip_vary on;
    gzip_types text/css text/javascript application/javascript
               text/plain application/json image/svg+xml
               image/x-icon image/png image/jpeg image/webp
               font/woff2 font/woff application/wasm;
    gzip_min_length 256;
    gzip_comp_level 5;
    gzip_proxied any;

    # ── Security Headers ──
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # CSP: self-only by default. 'unsafe-inline' stays because index.html
    # ships an inline bootstrap script; connect-src whitelists Sentry (active
    # only when a DSN is configured). Tighten once the inline script is gone.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 100M;
    root {{APP_ROOT}}/frontend/dist;
    index index.html;

    # SPA entry must always revalidate so new deploys are picked up instantly
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
        expires -1;
    }


    # ── WAF: Block malicious requests & enforce rate limiting ──
    # limit_req applies to /api/ locations only (was 429ing pages/assets)
    if ($bad_bot)     { return 403; }
    if ($attack_uri)  { return 403; }
    if ($sqli_attack) { return 403; }

    # SSE / Live Events Stream (no buffering, persistent)
    location /api/v2/events/ {
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
    }


    # Login brute-force gate (OWASP: 5r/m per IP)
    location /api/v2/login/ {
        limit_req zone=login_limit burst=5 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Heavy operations (ping sweeps, bulk automation): 30r/m
    location /api/v2/tools/ {
        limit_req zone=bulk_limit burst=10 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v2/automation/ {
        limit_req zone=bulk_limit burst=10 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Go API V2
    location /api/v2/ {
        limit_req zone=api_global burst=20 nodelay;
        proxy_pass http://nms_engine_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /logout {
        try_files $uri $uri/ /index.html;
    }

    # React App Hashed Assets (JS/CSS - immutable cache)
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # React App SPA routing (Never cache index.html so JS updates apply immediately)
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $uri $uri/ /index.html;
    }
}

# 5. Redirect HTTP (port 80) to HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

# 6. ntfy push notifications on Port 8080 (HTTPS, WebSocket for live push)
server {
    listen 8080 ssl;
    server_name _;

    ssl_certificate /etc/nginx/ssl/nms_chain.crt;
    ssl_certificate_key /etc/nginx/ssl/nms.key;

    auth_basic "NMS Secure Access";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for ntfy live push
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
